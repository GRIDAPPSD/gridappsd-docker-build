# Base image using Debian Bullseye with Python 3.10
FROM python:3.10-slim-bullseye

# Image metadata
ARG GRIDAPPSD_TAG=develop
LABEL org.opencontainers.image.source="https://github.com/GRIDAPPSD/gridappsd-docker-build"
LABEL org.opencontainers.image.description="GridAPPS-D Base Image"
LABEL org.opencontainers.image.version="${GRIDAPPSD_TAG}"

# Use bash with pipefail for better error handling in piped commands
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime and build dependencies
# Note: -dev packages needed for building GridLAB-D, State Estimator, ActiveMQ C++
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    # Core utilities
    wget \
    git \
    ca-certificates \
    openssl \
    procps \
    sudo \
    vim \
    # Build tools
    # cmake \
    m4 \
    libtool \
    make \
    g++ \
    # Python build deps
    python3-dev \
    # ActiveMQ C++ deps
    libaprutil1-dev \
    # Database client
    mariadb-client \
    # Math libraries (for state estimator)
    liblapack-dev \
    libblas-dev \
    # SSL/Boost/XML/ZMQ libraries
    libssl-dev \
    libboost-dev \
    libxerces-c-dev \
    libzmq5-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/archives/*

WORKDIR /gridappsd

# Environment variables (persisted in image)
ENV GRIDAPPSD=/gridappsd
ENV GLD_INSTALL=${GRIDAPPSD}
ENV TEMP_DIR=/tmp/source
ENV PYHELICS_INSTALL=${GRIDAPPSD}
ENV LD_LIBRARY_PATH=${PYHELICS_INSTALL}/lib

# ----------------------------------------------------
# INSTALL CMAKE 3.22 (needed for HELICS build)
# ----------------------------------------------------
RUN mkdir -p ${TEMP_DIR} \
    && cd ${TEMP_DIR} \
    && wget -q https://cmake.org/files/v3.22/cmake-3.22.6-linux-x86_64.sh \
    && chmod +x cmake-3.22.6-linux-x86_64.sh \
    && sudo ./cmake-3.22.6-linux-x86_64.sh --prefix=/usr/local --skip-license \
    && cd /tmp \
    && rm -rf ${TEMP_DIR}/cmake-3.22.6-linux-x86_64.sh

# ----------------------------------------------------
# INSTALL Helics
# ----------------------------------------------------
RUN mkdir -p ${TEMP_DIR} \
    && cd ${TEMP_DIR} \
    && git clone https://github.com/GMLC-TDC/HELICS.git \
    && cd HELICS \
    && git submodule update --init \
    && mkdir cmake-build \
    && cd cmake-build \
    && cmake -DCMAKE_INSTALL_PREFIX=${PYHELICS_INSTALL} .. \
    && cmake --build . -j$(nproc) --target install \
    && cd /tmp \
    && rm -rf ${TEMP_DIR}/HELICS

# ----------------------------------------------------
# INSTALL Helics Python Pachage
# ----------------------------------------------------
RUN pip install --no-cache-dir 'helics[cli]'

# ----------------------------------------------------
# INSTALL Gridlab-D
# ----------------------------------------------------
RUN mkdir -p ${TEMP_DIR} \
    && cd ${TEMP_DIR} \
    && git clone --depth 1 -b develop --single-branch https://github.com/gridlab-d/gridlab-d.git \
    && cd ${TEMP_DIR}/gridlab-d \
    && git submodule update --init --depth 1 \
    && mkdir cmake-build \
    && cd cmake-build \
    && cmake -DCMAKE_INSTALL_PREFIX=${GLD_INSTALL} -DGLD_USE_HELICS=ON -DGLD_HELICS_DIR=${PYHELICS_INSTALL}/lib/cmake/HELICS ../ \
    && cmake --build . -j$(nproc) --target install \
    && cd /tmp \
    && rm -rf ${TEMP_DIR}/gridlab-d

# ----------------------------------------------------
# INSTALL Java 21
# ----------------------------------------------------
ARG JAVA_VERSION=21.0.5+11
RUN mkdir -p ${TEMP_DIR} /usr/lib/jvm \
    && cd ${TEMP_DIR} \
    && wget -q https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.5%2B11/OpenJDK21U-jdk_x64_linux_hotspot_21.0.5_11.tar.gz \
    && tar -xzf OpenJDK21U-jdk_x64_linux_hotspot_21.0.5_11.tar.gz -C /usr/lib/jvm \
    && update-alternatives --install /usr/bin/java java /usr/lib/jvm/jdk-${JAVA_VERSION}/bin/java 1 \
    && update-alternatives --install /usr/bin/javac javac /usr/lib/jvm/jdk-${JAVA_VERSION}/bin/javac 1 \
    && rm -f ${TEMP_DIR}/OpenJDK21U-jdk_x64_linux_hotspot_21.0.5_11.tar.gz


# ----------------------------------------------------
# INSTALL Activemq c++ extensions
# ----------------------------------------------------
ARG ACTIVEMQ_CPP_VERSION=3.9.5
RUN mkdir -p ${TEMP_DIR} \
    && cd ${TEMP_DIR} \
    && wget -q http://archive.apache.org/dist/activemq/activemq-cpp/${ACTIVEMQ_CPP_VERSION}/activemq-cpp-library-${ACTIVEMQ_CPP_VERSION}-src.tar.gz \
    && tar -xzf activemq-cpp-library-${ACTIVEMQ_CPP_VERSION}-src.tar.gz \
    && cd activemq-cpp-library-${ACTIVEMQ_CPP_VERSION} \
    && ./configure --prefix=${GRIDAPPSD} \
    && make -j$(nproc) \
    && make install \
    && cd /tmp \
    && rm -rf ${TEMP_DIR}/activemq-cpp-library-${ACTIVEMQ_CPP_VERSION} \
    && rm -f ${TEMP_DIR}/activemq-cpp-library-${ACTIVEMQ_CPP_VERSION}-src.tar.gz

# ----------------------------------------------------
# INSTALL Python requirements
# ----------------------------------------------------
COPY ./requirements_base.txt /gridappsd/requirements_base.txt
RUN pip install --no-cache-dir -r /gridappsd/requirements_base.txt

# ----------------------------------------------------
# INSTALL State Estimator
# ----------------------------------------------------
RUN mkdir -p ${TEMP_DIR} \
    && cd ${TEMP_DIR} \
    && git clone --depth 1 https://github.com/GRIDAPPSD/gridappsd-state-estimator \
    && cd gridappsd-state-estimator \
    && git clone --depth 1 https://github.com/GRIDAPPSD/SuiteSparse \
    && git clone --depth 1 https://github.com/GRIDAPPSD/json \
    && LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:${TEMP_DIR}/gridappsd-state-estimator/SuiteSparse/lib/ \
    make -C SuiteSparse LAPACK=-llapack BLAS=-lblas \
    && make -C state-estimator AMQINCPATH3=/gridappsd/include/activemq-cpp-3.9.5 \
    && mkdir -p /gridappsd/services/gridappsd-state-estimator \
    && rm -rf .git SuiteSparse/.git json/.git \
    && cp -r * /gridappsd/services/gridappsd-state-estimator \
    && cp /gridappsd/services/gridappsd-state-estimator/state-estimator.config /gridappsd/services/ \
    && cd /tmp \
    && rm -rf ${TEMP_DIR}/gridappsd-state-estimator

# ----------------------------------------------------
# INSTALL Ochre
# ----------------------------------------------------
#RUN cd /gridappsd/services/ \
#    && git clone https://github.com/gridappsd/gridappsd-ochre \
#    && cd /gridappsd/services/gridappsd-ochre \
#    && pip install -r requirements.txt \
#    && rm -rf /root/.cache/pip/wheels

#ENV PYTHONPATH=${PYTHONPATH}:/gridappsd/services/gridappsd-ochre
#ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib64

# ----------------------------------------------------
# Set the JAVA_HOME variable
# ----------------------------------------------------
ENV JAVA_HOME=/usr/lib/jvm/jdk-21.0.5+11
ENV PATH=${JAVA_HOME}/bin:${PATH}

# ----------------------------------------------------
# Create gridappsd user with passwordless sudo
# ----------------------------------------------------
RUN groupadd -r gridappsd && \
    useradd -r -g gridappsd -G sudo -u 1000 -d /gridappsd -s /bin/bash gridappsd && \
    echo 'gridappsd ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    chown -R gridappsd:gridappsd /gridappsd

# ----------------------------------------------------
# Final cleanup
# ----------------------------------------------------
RUN rm -rf ${TEMP_DIR} /tmp/* /var/tmp/*

# Don't switch to gridappsd user yet - child images need root for apt-get
WORKDIR /gridappsd

# GridAPPS-D Docker Build Configuration
# Source this file before running build-images.sh:
#   source build.env && ./build-images.sh

# Docker image tag (optional, defaults to :develop)
export GRIDAPPSD_TAG=:rc2

# GOSS repository settings
export GOSS_URI=https://github.com/GridOPTICS/GOSS.git
export GOSS_BRANCH=update-for-security

# GOSS-GridAPPS-D repository settings
export GRIDAPPSD_URI=https://github.com/craig8/GOSS-GridAPPS-D.git
export GRIDAPPSD_BRANCH=java-update
